<div data-controller="access-rights">
  <fieldset class="mb-3">
    <legend>View rights</legend>
    <% VIEW_RIGHTS.each do |view_value| %>
      <%= render SdrViewComponents::Forms::RadioButtonComponent.new(
            form:,
            field_name: :view,
            label_text: view_value.titleize,
            input_data: { access_rights_target: stimulus_target_name(view_value, 'View'), action: 'access-rights#toggle' },
            input_value: view_value
          ) %>
    <% end %>
  </fieldset>

  <fieldset class="mb-3">
    <legend>Download rights</legend>
    <% DOWNLOAD_RIGHTS.each do |download_value| %>
      <%= render SdrViewComponents::Forms::RadioButtonComponent.new(
            form:,
            field_name: :download,
            label_text: download_value.titleize,
            input_data: { access_rights_target: stimulus_target_name(download_value, 'Download'), action: 'access-rights#toggle' },
            input_value: download_value
          ) %>
    <% end %>
  </fieldset>

  <fieldset class="mb-3">
    <legend>Location</legend>
    <% Constants::ACCESS_LOCATIONS.each do |location_value| %>
      <%= render SdrViewComponents::Forms::RadioButtonComponent.new(
            form:,
            field_name: :location,
            label_text: t("access.locations.#{location_value}"),
            input_data: { access_rights_target: 'location' },
            input_value: location_value
          ) %>
    <% end %>
  </fieldset>
</div>
